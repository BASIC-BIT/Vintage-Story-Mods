--- /dev/null
+++ b/mods-dll/agentcontrol.Tests/StartupEnableTests.cs
@@ -0,0 +1,89 @@
+using System.Reflection;
+using FluentAssertions;
+using Vintagestory.API.Client;
+
+namespace AgentControl.Tests;
+
+public sealed class StartupEnableTests
+{
+    [Fact]
+    public async Task StartupEnable_WaitsForReadinessAndCannotUndoCancellationOrDisable()
+    {
+        new AgentControlConfig().EnableOnStartup.Should().BeFalse();
+        var api = DispatchProxy.Create<ICoreClientAPI, ReadinessApi>();
+        var readiness = (ReadinessApi)(object)api;
+        var mod = new AgentControlModSystem();
+        var dispatcher = new GameThreadDispatcher();
+        Set(mod, "_api", api);
+        Set(mod, "_dispatcher", dispatcher);
+        Set(mod, "_config", new AgentControlConfig { EnableOnStartup = true, PipeName = $"agentcontrol-startup-{Guid.NewGuid():n}" });
+        Set(mod, "_enableOnStartupPending", true);
+        try
+        {
+            Call(mod, "OnTick", 0f);
+            Get<bool>(mod, "_enabled").Should().BeFalse();
+            Get<bool>(mod, "_enableOnStartupPending").Should().BeTrue();
+
+            readiness.Ready = true;
+            Call(mod, "OnTick", 0f);
+            Get<bool>(mod, "_enabled").Should().BeTrue();
+            Get<bool>(mod, "_enableOnStartupPending").Should().BeFalse();
+            readiness.Messages.Should().HaveCount(1);
+
+            var shutdown = (Task<RpcResponse>)Call(mod, "Shutdown", "shutdown")!;
+            Call(mod, "OnTick", 0f);
+            (await shutdown).Ok.Should().BeTrue();
+            Call(mod, "OnTick", 0f);
+            Get<bool>(mod, "_enabled").Should().BeFalse();
+            readiness.Messages.Should().HaveCount(1);
+
+            Call(mod, "Toggle");
+            Call(mod, "Toggle");
+            Call(mod, "OnTick", 0f);
+            Get<bool>(mod, "_enabled").Should().BeFalse();
+            readiness.Messages.Should().HaveCount(2);
+
+            foreach (var cancellation in new[] { "Kill", "Disable" })
+            {
+                readiness.Ready = false;
+                Set(mod, "_enableOnStartupPending", true);
+                if (cancellation == "Disable") Call(mod, cancellation, "pipe_failed");
+                else Call(mod, cancellation);
+                readiness.Ready = true;
+                Call(mod, "OnTick", 0f);
+                Get<bool>(mod, "_enabled").Should().BeFalse();
+                Get<bool>(mod, "_enableOnStartupPending").Should().BeFalse();
+            }
+        }
+        finally
+        {
+            Call(mod, "Disable", "test_cleanup");
+            dispatcher.Shutdown();
+        }
+    }
+
+    private static FieldInfo Field(string name) =>
+        typeof(AgentControlModSystem).GetField(name, BindingFlags.Instance | BindingFlags.NonPublic)!;
+
+    private static void Set(AgentControlModSystem mod, string name, object value) => Field(name).SetValue(mod, value);
+    private static T Get<T>(AgentControlModSystem mod, string name) => (T)Field(name).GetValue(mod)!;
+    private static object? Call(AgentControlModSystem mod, string name, params object[] args) =>
+        typeof(AgentControlModSystem).GetMethod(name, BindingFlags.Instance | BindingFlags.NonPublic)!.Invoke(mod, args);
+
+    public class ReadinessApi : DispatchProxy
+    {
+        public bool Ready { get; set; }
+        public List<string> Messages { get; } = [];
+
+        protected override object? Invoke(MethodInfo? method, object?[]? args)
+        {
+            if (method?.Name == "get_PlayerReadyFired") return Ready;
+            if (method?.Name == "ShowChatMessage")
+            {
+                Messages.Add((string)args![0]!);
+                return null;
+            }
+            throw new NotSupportedException(method?.Name);
+        }
+    }
+}
