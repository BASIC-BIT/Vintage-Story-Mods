--- /dev/null
+++ b/scripts/td-video-review/test_review_video.py
@@ -0,0 +1,92 @@
+"""Offline request checks. Run: python test_review_video.py. No provider calls."""
+import contextlib
+import importlib.util
+import io
+import json
+import tempfile
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import patch
+
+spec = importlib.util.spec_from_file_location("wizard_review", Path(__file__).with_name("review_video.py"))
+review = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(review)
+
+
+def check():
+    secret = "TEST-KEY-DO-NOT-LOG"
+    session_url = review.API_ROOT + "/upload-session/TEST-CAPABILITY-DO-NOT-LOG"
+    with tempfile.TemporaryDirectory() as directory:
+        folder = Path(directory)
+        video, rubric, report = folder / "poses.mp4", folder / "rubric.md", folder / "report.md"
+        video.write_bytes(b"mock video bytes")
+        rubric.write_text("Inspect sampled poses only.", encoding="utf-8")
+
+        def run(failure=None):
+            calls = []
+
+            def request(method, url, **kwargs):
+                assert secret not in url and "?key=" not in url
+                assert kwargs["headers"]["x-goog-api-key"] == secret
+                assert 0 < kwargs["timeout"] <= review.HTTP_TIMEOUT
+                calls.append((method, url, kwargs))
+                response = SimpleNamespace(status_code=200, headers={}, text=secret)
+                if url.endswith("/upload/v1beta/files"):
+                    if failure == "upload":
+                        raise review.requests.ConnectionError(secret + session_url)
+                    assert method == "POST"
+                    response.headers = {"X-Goog-Upload-URL": session_url}
+                elif url == session_url:
+                    assert method == "POST" and kwargs["data"] == video.read_bytes()
+                    response.json = lambda: {"file": {"name": "files/test", "state": "PROCESSING"}}
+                elif url.endswith("/files/test"):
+                    assert method in ("GET", "DELETE")
+                    response.json = lambda: {"name": "files/test", "state": "ACTIVE", "uri": "https://example.invalid/test"}
+                elif url.endswith("/models/test-model:generateContent"):
+                    assert method == "POST"
+                    parts = kwargs["json"]["contents"][0]["parts"]
+                    assert parts[0]["videoMetadata"] == {"fps": 4}
+                    assert parts[0]["fileData"]["mimeType"] == "video/mp4"
+                    assert "not a real-time recording" in parts[1]["text"]
+                    assert "not\nhuman acceptance" in parts[1]["text"]
+                    if failure == "model":
+                        response.status_code = 400
+                    elif failure == "model-network":
+                        raise review.requests.ConnectionError(secret + session_url)
+                    response.json = lambda: {"candidates": [{"content": {"parts": [{"text": json.dumps({
+                        "criteria": [{"name": "sampled poses", "verdict": "PASS", "evidence": "00:00.250 visible", "prescription": ""}],
+                        "summary": "Only samples were inspected."
+                    })}]}}]}
+                else:
+                    raise AssertionError("unexpected request")
+                return response
+
+            output = io.StringIO()
+            with patch.dict(review.os.environ, {"GEMINI_API_KEY": secret}), \
+                    patch.object(review.sys, "argv", ["review_video.py", "--video", str(video), "--rubric", str(rubric), "--model", "test-model", "--out", str(report)]), \
+                    patch.object(review.requests, "post", side_effect=lambda url, **kwargs: request("POST", url, **kwargs)), \
+                    patch.object(review.requests, "get", side_effect=lambda url, **kwargs: request("GET", url, **kwargs)), \
+                    patch.object(review.requests, "delete", side_effect=lambda url, **kwargs: request("DELETE", url, **kwargs)), \
+                    patch.object(review.requests.sessions.Session, "request", side_effect=AssertionError("network forbidden")), \
+                    patch.object(review.time, "sleep"), \
+                    contextlib.redirect_stdout(output), contextlib.redirect_stderr(output):
+                status = review.main()
+            assert secret not in output.getvalue() and session_url not in output.getvalue()
+            return status, calls
+
+        status, calls = run()
+        assert status == 0 and len(calls) == 5
+        assert calls[-1][0] == "DELETE"
+        text = report.read_text(encoding="utf-8")
+        assert "4 Hz" in text and "does not establish human acceptance" in text
+        for failure in ("upload", "model", "model-network"):
+            status, calls = run(failure)
+            assert status == 1
+            if failure != "upload":
+                assert calls[-1][0] == "DELETE"
+        assert review.parse_verdict('{"criteria": []}')["overall"] == "FIX-THEN-SHIP"
+    print("Offline reviewer checks passed: header auth, 4fps payload, cleanup, and redacted failures.")
+
+
+if __name__ == "__main__":
+    check()
