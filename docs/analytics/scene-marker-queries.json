    {
      "name": "Scene markers: consecutive complete weeks of explicit usage",
      "query": {
        "kind": "HogQLQuery",
        "query": "WITH active AS (\n  SELECT toStartOfWeek(timestamp, 1) AS week, distinct_id\n  FROM events\n  WHERE timestamp >= toStartOfWeek(now(), 1) - INTERVAL 8 WEEK\n    AND timestamp < toStartOfWeek(now(), 1)\n    AND event = 'feature used'\n    AND properties.feature_name = 'scene_markers'\n    AND properties.action IN ('placed', 'saved', 'reader_opened', 'marked_read', 'marked_unread', 'removed')\n  GROUP BY week, distinct_id\n)\nSELECT previous.week + INTERVAL 1 WEEK AS week,\n  count(DISTINCT previous.distinct_id) AS prior_week_installations,\n  count(DISTINCT nullIf(current.distinct_id, '')) AS returning_installations,\n  100.0 * count(DISTINCT nullIf(current.distinct_id, '')) / count(DISTINCT previous.distinct_id) AS returning_percent\nFROM active AS previous\nLEFT JOIN active AS current ON current.distinct_id = previous.distinct_id\n  AND current.week = previous.week + INTERVAL 1 WEEK\nWHERE previous.week + INTERVAL 1 WEEK < toStartOfWeek(now(), 1)\nGROUP BY previous.week\nORDER BY week"
      }
    }
